# ===== 数据库连接（填好后把本文件另存为 .env）=====
# 生产库：Supabase（Settings → Database → Connection String，整串复制）
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 开发库：本地 PostgreSQL
DATABASE_URL_LOCAL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/musttoukou

# ===== 网站口令门（自己随便定一个，用于登录网站）=====
ACCESS_PASSWORD=change-me

# ===== DSAT 接口（固定值，勿改）=====
DSAT_BASE_URL=https://bis.dsat.gov.mo:37812/macauweb
